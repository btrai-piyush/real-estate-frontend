# Required by Auth.js / NextAuth
AUTH_SECRET=replace-with-a-long-random-string

# API base URL used by src/api/api.js.
# For local development without a reverse proxy, use full backend URL.
NEXT_PUBLIC_BASE_PATH=http://localhost:5000/api

# Optional direct auth API URL fallback for login/register/logout.
# Use only if your /api proxy does not forward auth cookies correctly.
# NEXT_PUBLIC_AUTH_BASE_URL=https://api.yourdomain.com/api

# Optional compatibility alias; NEXT_PUBLIC_BASE_PATH is preferred.
# NEXT_PUBLIC_BASE_URL=http://localhost:5000/api

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyCsZQ5YAO4sEs6HvIqC_AjiqaPodkvEm0w
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=replace-with-your-map-id
