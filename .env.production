# Required by Auth.js / NextAuth
AUTH_SECRET=replace-with-a-long-random-string

# API base URL used by src/api/api.js.
# Keep '/api' only if your deployed app has a reverse proxy/rewrite for /api.
NEXT_PUBLIC_BASE_PATH=/api

# Optional direct auth API URL fallback for login/register/logout.
# NEXT_PUBLIC_AUTH_BASE_URL=https://api.yourdomain.com/api

# Optional compatibility alias; NEXT_PUBLIC_BASE_PATH is preferred.
# NEXT_PUBLIC_BASE_URL=https://api.yourdomain.com/api

# Optional: only needed if you implement Next.js rewrites that reference API_URL.
# API_URL=https://api.yourdomain.com
